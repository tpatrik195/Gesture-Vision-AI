    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "copy:mediapipe": "node -e \"const fs=require('fs'),p=require('path');const src=p.join('node_modules','@mediapipe','selfie_segmentation');const dst=p.join('public','mediapipe','selfie_segmentation');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src))if(!/\\.(md|ts|json)$/.test(f))fs.copyFileSync(p.join(src,f),p.join(dst,f));console.log('mediapipe assets copied');\"",
    "prestart": "npm run copy:mediapipe",
    "prebuild": "npm run copy:mediapipe"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-webcam": "^1.1.0",
    "http-proxy-middleware": "^2.0.6"
  }
}
