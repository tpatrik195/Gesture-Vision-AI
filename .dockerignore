# Secrets are passed at runtime via env_file, never baked into an image.
.env
.env.*
!.env.example

.git
.gitignore

**/node_modules
**/__pycache__
**/*.pyc
**/.venv
venv/

client_frontend/build
client_frontend/public/mediapipe

docs/
# export_data.py runs inside the api container to reach the database over the
# internal network, so meresek/ is included except its data and legacy scripts.
meresek/legacy/
meresek/data/
tools/
browser_extension/
*.log
