# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Database ---
POSTGRES_USER=gesture
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=gesture_db
POSTGRES_PORT=5432
# Used by the API container (host "db" is the compose service name).
DATABASE_URL=postgresql+psycopg2://gesture:change_me_to_a_long_random_value@db:5432/gesture_db

# --- Deployment ---
# Caddy site address. ":80" serves plain HTTP for local testing; set a real
# domain (DNS must already point here) and TLS is obtained automatically.
#   SITE_ADDRESS=gesture.example.com
SITE_ADDRESS=:80
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2G

# --- Security ---
# Comma-separated list of allowed browser origins.
# "*" is acceptable for local development only; set real origins in production:
#   ALLOWED_ORIGINS=https://gesture.example.com
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=false
SESSION_TOKEN_TTL=43200

# --- Limits ---
MAX_CONCURRENT_SESSIONS=25
MAX_FRAMES_PER_SECOND=20
MAX_FRAME_BYTES=2097152
REST_RATE_LIMIT_PER_MINUTE=60
SESSION_IDLE_TIMEOUT=900

# --- Gesture tuning ---
GESTURE_THRESHOLD=3
MIN_CONFIDENCE=0.45
GESTURE_HOLD_SECONDS=0.18
GESTURE_COOLDOWN_SECONDS=0.9
COMMAND_MODE_WINDOW_SECONDS=4.0
POINTER_EMIT_INTERVAL=0.04

# --- Model ---
# Defaults to app/models/hand_landmarker.task when unset.
# MODEL_PATH=/srv/app/models/hand_landmarker.task
MAX_HANDS=2
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# --- Runtime ---
TELEMETRY_ENABLED=true
LOG_LEVEL=INFO

# --- Frontend (development only) ---
# Where the CRA dev server proxies API and WebSocket traffic.
DEV_API_TARGET=http://localhost:8000
